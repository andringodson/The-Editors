# Copy to .env.local and fill in. Everything here is optional — with no values
# set the site builds and all seven browser-based tools work. These switch on
# accounts, telemetry, and Office→PDF respectively.

# --- Supabase (auth + anonymous telemetry) ---------------------------------
# From Supabase → Project Settings → API. Both are safe to expose to the
# browser; row-level security in supabase/schema.sql is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Office→PDF conversion service -----------------------------------------
# Public base URL of the deployed container in services/converter.
NEXT_PUBLIC_CONVERTER_URL=

# Shared secret used to sign short-lived conversion tokens. Must match the
# CONVERT_SIGNING_SECRET set on the converter service. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
CONVERT_SIGNING_SECRET=

# --- Advertising (Google AdSense) -------------------------------------------
# Your publisher id, e.g. ca-pub-1234567890123456. With this unset no ad code
# loads at all and the Content-Security-Policy stays in its strict form — see
# next.config.ts, which only widens the policy when ads are switched on.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad unit ids from the AdSense dashboard. Slots render nothing until filled in.
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
