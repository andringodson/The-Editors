# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Both values are safe to expose to the browser —
# row-level security in supabase/schema.sql is what actually protects data.
#
# Leave these unset and the site still builds and runs; auth and telemetry
# simply switch off.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
